# ── Server Configuration ──
MCP_SERVER_NAME=NetraAI Diagnostic Engine
MCP_SERVER_VERSION=1.0.0
ENVIRONMENT=development

# ── Security (P1: Added missing variables) ──
MCP_API_KEY=your-secret-api-key-here-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com
MCP_RATE_LIMIT=30

# ── Database ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here

# ── Monitoring & Observability ──
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_TRACES_RATE=0.2
AUDIT_LOGGING_ENABLED=true

# ── Logging ──
DEBUG=false

# ── ML Services ──
ANEMIA_SERVICE_URL=https://sunaypotnuru-netra-anemia.hf.space
CATARACT_SERVICE_URL=https://sunaypotnuru-netra-cataract-detection.hf.space
DR_SERVICE_URL=https://sunaypotnuru-netra-diabetic-retinopathy.hf.space
MENTAL_HEALTH_SERVICE_URL=https://rohith-panduru-netra-mental.hf.space
PARKINSONS_SERVICE_URL=https://rohith-panduru-netra-parkinsons.hf.space
