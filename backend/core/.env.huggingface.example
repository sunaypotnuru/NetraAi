# Hugging Face Spaces Environment Variables Template
# Copy these to your Space's Settings > Variables

# ============================================
# DATABASE (Supabase)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ============================================
# ML SERVICE URLS (Hugging Face Spaces)
# ============================================
ANEMIA_SERVICE_URL=https://your-username-netra-anemia.hf.space
CATARACT_SERVICE_URL=https://your-username-netra-cataract.hf.space
DR_SERVICE_URL=https://your-username-netra-dr.hf.space
MENTAL_HEALTH_SERVICE_URL=https://your-username-netra-mental-health.hf.space
PARKINSONS_SERVICE_URL=https://your-username-netra-parkinsons.hf.space
MCP_SERVER_URL=https://your-username-netra-mcp-server.hf.space

# ============================================
# API CONFIGURATION
# ============================================
FRONTEND_URL=https://netra-ai.vercel.app
ENVIRONMENT=production
API_V1_STR=/api/v1
BYPASS_AUTH=false
ALLOWED_HOSTS=*.hf.space,localhost,127.0.0.1

# ============================================
# OPTIONAL SERVICES
# ============================================
# Sentry (Error Tracking)
SENTRY_DSN=

# AI Services (Optional)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Redis (Optional - for caching)
REDIS_URL=

# Demo Mode (set to true for demo features)
DEMO_MODE=false

# ============================================
# SECURITY
# ============================================
# JWT Secret (generate a strong random string)
JWT_SECRET=your_jwt_secret_here_generate_random_string

# Session Configuration
SESSION_TIMEOUT_MINUTES=30
MAX_SESSIONS_PER_USER=5

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============================================
# MONITORING (Optional)
# ============================================
# APM Service URL (if using separate monitoring service)
APM_SERVICE_URL=

# IEC 62304 Compliance Service URL
IEC62304_SERVICE_URL=

# SOC 2 Compliance Service URL
SOC2_SERVICE_URL=
